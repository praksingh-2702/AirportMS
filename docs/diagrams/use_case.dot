  UC05 -> ADM;
  UC09 -> ADM;
  UC10 -> ADM;
  UC11 -> ADM;
  UC18 -> ADM;
  UC19 -> ADM;
  UC20 -> ADM;
  UC21 -> ADM;
  UC07 -> UC08 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  UC11 -> UC12 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  UC14 -> UC15 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  UC18 -> UC22 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  UC19 -> UC22 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  UC21 -> UC09 [dir=forward style=dashed label="«include»" fontname="DejaVu Sans" fontsize=10 constraint=false];
  USR -> PAX [dir=back arrowtail=onormal arrowsize=1.2 constraint=false];
  USR -> STF [dir=back arrowtail=onormal arrowsize=1.2 constraint=false];
  ADM -> USR [dir=forward arrowhead=onormal arrowsize=1.2 constraint=false];
}