  "4.5" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.45 label="4.5\nCancel\nBooking"];
  "D2" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D2</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Flights</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "D3" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D3</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Bookings</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "PAX_4.1" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "PAX_4.4" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "PAX_4.5" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "PAX_4.1" -> "4.1" [label="Booking request"];
