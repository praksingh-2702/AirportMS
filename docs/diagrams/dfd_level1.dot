digraph "Level 1" {
  graph [rankdir=TB splines=true nodesep=0.3 ranksep=1.3 fontname="DejaVu Sans" pad=0.3 newrank=true];
  edge [color="#444444" fontname="DejaVu Sans" fontsize=10 arrowsize=0.7];
  "1.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="1.0\nManage Users &\nAuthenticate"];
  "2.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="2.0\nSchedule\nFlights"];
  "3.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="3.0\nSearch\nFlights"];
  "4.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="4.0\nBook / Cancel\nTicket"];
  "5.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="5.0\nCheck In\nPassenger"];
  "6.0" [shape=circle style=filled fillcolor="#D9E8FB" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 fixedsize=true width=1.5 label="6.0\nManage\nBaggage"];
  "D1" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D1</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Users</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "D2" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D2</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Flights</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "D3" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D3</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Bookings</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "D4" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D4</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Baggage</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "PAX_1.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "STF_1.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Check-in Staff"];
  "ADM_1.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Administrator"];
  "ADM_2.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Administrator"];
  "PAX_3.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "PAX_4.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "STF_5.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Check-in Staff"];
  "PAX_5.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
  "STF_6.0" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Check-in Staff"];
  "PAX_1.0" -> "1.0" [label="Registration details\nLogin credentials"];
  "PAX_1.0" -> "1.0" [label="Registration confirmation\nAuthentication result" dir=back];
  "STF_1.0" -> "1.0" [label="Login credentials"];
  "STF_1.0" -> "1.0" [label="Authentication result" dir=back];
  "ADM_1.0" -> "1.0" [label="Login credentials\nStaff account details"];
  "ADM_1.0" -> "1.0" [label="Authentication result\nUser list" dir=back];
  "1.0" -> "D1" [label="User record"];
  "1.0" -> "D1" [label="Stored credentials\nExisting usernames\nUser record" dir=back];
  "2.0" -> "ADM_2.0" [label="Flight details\nGate assignment\nFlight status change\nFlight cancellation" dir=back];
  "2.0" -> "ADM_2.0" [label="Flight schedule\nSchedule confirmation"];
  "D2" -> "2.0" [label="Flight record\nGate schedule"];
  "D2" -> "2.0" [label="Flight record" dir=back];
  "D3" -> "2.0" [label="Booking status update" dir=back];
  "PAX_3.0" -> "3.0" [label="Search criteria"];
  "PAX_3.0" -> "3.0" [label="Flight list" dir=back];
  "3.0" -> "D2" [label="Flight record" dir=back];
  "3.0" -> "D3" [label="Taken seats" dir=back];
  "PAX_4.0" -> "4.0" [label="Booking request\nCancellation request"];
  "PAX_4.0" -> "4.0" [label="Seat availability\nBooking confirmation\nCancellation confirmation" dir=back];
  "4.0" -> "D2" [label="Flight record" dir=back];
  "4.0" -> "D3" [label="Taken seats\nBooking record\nExisting PNRs" dir=back];
  "4.0" -> "D3" [label="Booking record"];
  "5.0" -> "STF_5.0" [label="PNR" dir=back];
  "5.0" -> "STF_5.0" [label="Booking details\nBoarding pass"];
  "5.0" -> "PAX_5.0" [label="Boarding pass"];
  "D3" -> "5.0" [label="Booking record"];
  "D2" -> "5.0" [label="Flight record"];
  "D1" -> "5.0" [label="Passenger name"];
  "D3" -> "5.0" [label="Check-in status" dir=back];
  "6.0" -> "STF_6.0" [label="Bag details\nBag status update" dir=back];
  "6.0" -> "STF_6.0" [label="Bag tag\nBaggage summary"];
  "D3" -> "6.0" [label="Booking record"];
  "D4" -> "6.0" [label="Bag record" dir=back];
  "D4" -> "6.0" [label="Bag record"];
  "1.0" -> "3.0" [style=invis weight=10];
  "3.0" -> "4.0" [style=invis weight=10];
  "2.0" -> "5.0" [style=invis weight=10];
  "5.0" -> "6.0" [style=invis weight=10];
  { rank=same; "PAX_1.0"; "STF_1.0"; "ADM_1.0"; "PAX_3.0"; "PAX_4.0"; }
  { rank=same; "1.0"; "3.0"; "4.0"; }
  { rank=same; "D1"; "D2"; "D3"; "D4"; }
  { rank=same; "2.0"; "5.0"; "6.0"; }
  { rank=same; "ADM_2.0"; "STF_5.0"; "PAX_5.0"; "STF_6.0"; }
}