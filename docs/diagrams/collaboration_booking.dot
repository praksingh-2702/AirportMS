digraph "collaboration_booking" {
  graph [rankdir=TB bgcolor="#FFFFFF" fontname="DejaVu Sans" pad=0.3 splines=true nodesep=0.6 ranksep=1.0];
  node [fontname="DejaVu Sans" fontsize=12 color="#000000" fillcolor="#D9E8FB" style=filled penwidth=1.3];
  edge [fontname="DejaVu Sans" fontsize=10 color="#444444" arrowsize=0.7];
  node [shape=box fontsize=13]; edge [fontsize=12 dir=none];
  labelloc=t label="Collaboration Diagram - Book and Pay" fontsize=16;
  actor [shape=none style=none image="/tmp/claude-0/-home-claude/175e18c3-3ae4-54e1-bc52-2203469a8b02/scratchpad/clean/AirportMS/docs/diagrams/_actor.png" labelloc=b height=1.6 label="Passenger"];
  bv [label=<<U>:BookingView</U>>];
  pd [label=<<U>:PaymentDialog</U>>];
  ps [label=<<U>:PaymentService</U>>];
  bs [label=<<U>:BookingService</U>>];
  gw [label=<<U>:Gateway</U>>];
  db [label=<<U>:SQLite DB</U>>];
  actor -> bv [label="1: select flight and seat →"];
  bv -> pd [label="2: open(fare breakdown) →"];
  actor -> pd [label="3: pay(method, details) →\n5: payment successful (PNR, invoice) ←"];
  pd -> ps [label="4: book_and_pay(user, flight, seat, ...) →\n4.6: (booking, payment) ←"];
  ps -> bs [label="4.1: book_ticket(user, flight, seat) →"];
  bs -> db [label="4.2: INSERT booking →"];
  ps -> gw [label="4.3: authorize(method, details, amount) →\n4.4: approved / declined ←"];
  ps -> db [label="4.5: INSERT payment →"];
}