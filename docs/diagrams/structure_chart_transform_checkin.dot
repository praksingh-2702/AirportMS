digraph "structure_chart_transform_checkin" {
  graph [rankdir=TB bgcolor="#FFFFFF" fontname="DejaVu Sans" pad=0.3 splines=true nodesep=0.35 ranksep=0.9];
  node [fontname="DejaVu Sans" fontsize=12 color="#000000" fillcolor="#D9E8FB" style=filled penwidth=1.3];
  edge [fontname="DejaVu Sans" fontsize=10 color="#444444" arrowsize=0.7];
  node [shape=box style=filled fillcolor="white" width=1.6];
  labelloc=t label="Structure Chart 2 - Transform Analysis of DFD 0.5 (Check In Passenger)" fontsize=14;
  root [label="Check In Passenger\nCheckInService.check_in()" fillcolor="#D9E8FB"];
  aff [label="Get Booking Details\nfind_booking()" fillcolor="white"];
  vp [label="Validate PNR\nvalidate_pnr()" fillcolor="white" peripheries=2];
  fb [label="Fetch Booking Row\nDETAILS_SQL query" fillcolor="white"];
  ce [label="Verify Eligibility\n(status, payment, window)" fillcolor="white"];
  pay [label="Check Payment Status\nSELECT payments (PAID)" fillcolor="white"];
  win [label="Check Time Window\n48 h / 45 min" fillcolor="white"];
  seq [label="Assign Boarding Seq\nMAX(seq)+1, UPDATE" fillcolor="white"];
  eff [label="Produce Boarding Pass\nget_boarding_pass()" fillcolor="white"];
  fmt [label="Format Pass\nBoardingPass.as_text()" fillcolor="white"];
  pdf [label="Export Pass PDF\nrender_boarding_pass()" fillcolor="white"];
  root -> aff [label="○ booking_details ↑" arrowsize=0.7];
  aff -> vp [label="○ raw_pnr ↓\n○ pnr ↑" arrowsize=0.7];
  aff -> fb [label="○ pnr ↓\n○ booking_details ↑" arrowsize=0.7];
  root -> ce [label="○ booking_details ↓\n○ now ↓\n● eligible ↑" arrowsize=0.7];
  ce -> pay [label="○ booking_id ↓\n● paid ↑" arrowsize=0.7];
  ce -> win [label="○ departure ↓\n○ now ↓\n● window_open ↑" arrowsize=0.7];
  root -> seq [label="○ booking_id ↓\n○ boarding_seq ↑" arrowsize=0.7];
  root -> eff [label="○ pnr ↓\n○ boarding_pass ↑" arrowsize=0.7];
  eff -> fmt [label="○ boarding_pass ↓\n○ pass_text ↑" arrowsize=0.7];
  eff -> pdf [label="○ boarding_pass ↓\n○ pdf_bytes ↑" arrowsize=0.7];
  legend [shape=note fillcolor="#EEEEEE" fontsize=10 label="○ data couple   ● control flag\n↓ passed to called module   ↑ returned to caller\ndouble border = library module"];
}