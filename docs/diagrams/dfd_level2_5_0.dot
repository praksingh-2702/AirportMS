  "D3" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD SIDES="TBR" BGCOLOR="#E6E6E6"><B>D3</B></TD><TD SIDES="TB" WIDTH="110" ALIGN="LEFT">Bookings</TD></TR></TABLE>> fontname="DejaVu Sans" fontsize=12];
  "STF_5.1" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Check-in Staff"];
  "STF_5.4" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Check-in Staff"];
  "PAX_5.4" [shape=box style=filled fillcolor="#FFF4C2" color="#000000" penwidth=1.6 fontname="DejaVu Sans" fontsize=12 margin="0.15,0.08" label="Passenger"];
