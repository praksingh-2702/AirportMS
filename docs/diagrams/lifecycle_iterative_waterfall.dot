digraph "lifecycle" {
  graph [rankdir=TB bgcolor="#FFFFFF" fontname="DejaVu Sans" pad=0.3 splines=true nodesep=0.4 ranksep=0.35];
  node [fontname="DejaVu Sans" fontsize=12 color="#000000" fillcolor="#D9E8FB" style=filled penwidth=1.3];
  edge [fontname="DejaVu Sans" fontsize=10 color="#444444" arrowsize=0.7];
  node [shape=box style="rounded,filled" width=2.3 height=0.8];
  p0 [label="Feasibility Study"];
  p1 [label="Requirements Analysis\n& Specification (SRS)"];
  p2 [label="Design\n(SA/SD + OOD)"];
  p3 [label="Coding &\nUnit Testing"];
  p4 [label="Integration &\nSystem Testing"];
  p5 [label="Maintenance"];
  p0 -> p1 [weight=10 color="#333333"];
  p1 -> p0 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p1 -> p2 [weight=10 color="#333333"];
  p2 -> p1 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p2 -> p3 [weight=10 color="#333333"];
  p3 -> p2 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p3 -> p4 [weight=10 color="#333333"];
  p4 -> p3 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p4 -> p5 [weight=10 color="#333333"];
  p5 -> p4 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
}