digraph "lifecycle_iterative_waterfall" {
  graph [fontname="DejaVu Sans" pad=0.3 rankdir=TB nodesep=0.4 ranksep=0.35];
  node [fontname="DejaVu Sans" fontsize=12];
  edge [fontname="DejaVu Sans" fontsize=10 color="#333333"];
  node [shape=box style="rounded,filled" fillcolor="#D9E8FB" width=2.3 height=0.8];
  p0 [label="Feasibility Study"];
  p1 [label="Requirements Analysis
& Specification (SRS)"];
  p2 [label="Design
(SA/SD + OOD)"];
  p3 [label="Coding &
Unit Testing"];
  p4 [label="Integration &
System Testing"];
  p5 [label="Maintenance"];
  p0 -> p1 [weight=10];
  p1 -> p0 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p1 -> p2 [weight=10];
  p2 -> p1 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p2 -> p3 [weight=10];
  p3 -> p2 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p3 -> p4 [weight=10];
  p4 -> p3 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
  p4 -> p5 [weight=10];
  p5 -> p4 [style=dashed color="#C62828" constraint=false label="feedback" fontcolor="#C62828"];
}
