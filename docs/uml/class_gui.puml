@startuml
!include _style.iuml
hide empty members
package "ams.gui (presentation layer)" {
  class AirportApp {
    +show_login()
    +show_dashboard(user)
    +refresh_stats()
  }
  class AppContext {
    +auth : AuthService
    +flights : FlightService
    +schedule : ScheduleService
    +bookings : BookingService
    +payments : PaymentService
    +checkin : CheckInService
    +user : User
    +now() : datetime
    +stats() : list
  }
  class Header
  class TabHost {
    +add(view, text)
    +select(view)
  }
  class StatCard {
    +set(value)
  }
  class LoginView {
    +login()
    +open_register()
  }
  class RegisterDialog
  class FlightView {
    +refresh(quiet)
    +add()  +update()  +cancel()
  }
  class ScheduleView {
    +generate()
    +add()  +toggle()
  }
  class BookingView {
    +search()
    +book()
    +pay_selected()
    +download_receipt()
    +cancel()
  }
  class SeatMap {
    +pick(seat)
    +confirm()
  }
  class PaymentDialog {
    +pay()
    +download_receipt()
  }
  class CheckInView {
    +lookup()
    +check_in()
    +download()
    +add_bag()
  }
  class BoardingPassView {
    +refresh()
    +download()
  }
  class UsersView
  class DataTable {
    +load(rows)
    +selected_id()
  }
  class FormPanel
  class DateEntry
  class CalendarPopup
  class Button
}
AirportApp *-- AppContext
AirportApp *-- Header
AirportApp *-- TabHost
AirportApp *-- "4" StatCard
TabHost o-- "*" FlightView
TabHost o-- "*" ScheduleView
TabHost o-- "*" BookingView
TabHost o-- "*" CheckInView
TabHost o-- "*" BoardingPassView
TabHost o-- "*" UsersView
AirportApp ..> LoginView : shows
LoginView ..> RegisterDialog
BookingView ..> SeatMap : opens
BookingView ..> PaymentDialog : opens
FlightView *-- DataTable
BookingView *-- DataTable
ScheduleView *-- DataTable
CheckInView *-- DataTable
BoardingPassView *-- DataTable
FlightView *-- FormPanel
ScheduleView *-- FormPanel
UsersView *-- FormPanel
FormPanel o-- DateEntry
FlightView *-- DateEntry
BookingView *-- DateEntry
DateEntry ..> CalendarPopup : opens
FlightView ..> AppContext : uses services
BookingView ..> AppContext
CheckInView ..> AppContext
PaymentDialog ..> AppContext
@enduml
