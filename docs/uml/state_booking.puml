@startuml
!include _style.iuml
title State Chart - Booking
[*] --> BOOKED : book_ticket()\n[seat free, flight bookable]
BOOKED --> CHECKED_IN : check_in()\n[48 h >= time to dep >= 45 min]\n/ assign boarding_seq
BOOKED --> CANCELLED : cancel_booking()\n[before departure]
BOOKED --> CANCELLED : cancel_flight()
CHECKED_IN --> CANCELLED : cancel_flight()
CHECKED_IN --> [*]
CANCELLED --> [*]
BOOKED : seat held
CHECKED_IN : boarding pass available\nbags can be added
CANCELLED : seat released
@enduml
