@startuml
!include _style.iuml
hide empty members
package "ams.models (entity classes)" {
  enum Role {
    ADMIN
    STAFF
    PASSENGER
  }
  enum FlightStatus {
    SCHEDULED
    DELAYED
    BOARDING
    DEPARTED
    CANCELLED
  }
  enum BookingStatus {
    BOOKED
    CHECKED_IN
    CANCELLED
  }
  enum BagStatus {
    CHECKED_IN
    LOADED
    UNLOADED
    CLAIMED
    MISHANDLED
  }
  enum PaymentStatus {
    PAID
    REFUNDED
  }
  class User {
    +user_id : int
    +username : str
    +role : Role
    +full_name : str
    +email : str
    +phone : str
  }
  class Flight {
    +flight_id : int
    +flight_no : str
    +airline : str
    +origin : str
    +destination : str
    +departure : datetime
    +arrival : datetime
    +gate : str [0..1]
    +rows : int
    +fare : int
    +status : FlightStatus
    +capacity() : int
  }
  class FlightTemplate {
    +template_id : int
    +flight_no : str
    +origin : str
    +destination : str
    +dep_time : str
    +duration_min : int
    +days : str
    +base_fare : int
    +active : bool
    +days_label() : str
  }
  class Booking {
    +booking_id : int
    +pnr : str
    +seat : str
    +fare : int
    +status : BookingStatus
    +booked_at : datetime
    +boarding_seq : int [0..1]
  }
  class Bag {
    +bag_id : int
    +tag_no : str
    +weight_kg : float
    +status : BagStatus
  }
  class BoardingPass {
    +pnr : str
    +passenger_name : str
    +flight_no : str
    +boarding_time : datetime
    +gate : str [0..1]
    +seat : str
    +boarding_seq : int
    +as_text() : str
  }
  class Payment {
    +payment_id : int
    +invoice_no : str
    +method : str
    +instrument : str
    +amount : int
    +status : PaymentStatus
    +reference : str
    +paid_at : datetime
    +refund_amount : int
    +refund_reason : str [0..1]
  }
  class FareBreakdown {
    +base_fare : int
    +airport_fee : int
    +gst : int
    +convenience_fee : int
    +total() : int
  }
  class RefundQuote {
    +refund : int
    +charge : int
    +percent : int
    +convenience_fee : int
  }
}
User "1" -- "*" Booking : holds >
Flight "1" -- "*" Booking : carries >
Booking "1" -- "*" Bag : has >
Booking "1" -- "0..1" Payment : is paid by >
Payment *-- "1" FareBreakdown
FlightTemplate "1" -- "*" Flight : generates >
BoardingPass ..> Booking : built from
RefundQuote ..> Payment : computed from
User ..> Role
Flight ..> FlightStatus
Booking ..> BookingStatus
Bag ..> BagStatus
Payment ..> PaymentStatus
@enduml
