@startuml
!include _style.iuml
hide empty members
skinparam linetype ortho
package "ams.models (entity classes)" {
  enum Role {
    ADMIN
    STAFF
    PASSENGER
  }
  enum FlightStatus {
    SCHEDULED
    DELAYED
    BOARDING
    DEPARTED
    CANCELLED
  }
  enum BookingStatus {
    BOOKED
    CHECKED_IN
    CANCELLED
  }
  enum BagStatus {
    CHECKED_IN
    LOADED
    UNLOADED
    CLAIMED
    MISHANDLED
  }
  class User {
    +user_id : int
    +username : str
    +role : Role
    +full_name : str
    +email : str
    +phone : str
    +from_row(row) : User
  }
  class Flight {
    +flight_id : int
    +flight_no : str
    +airline : str
    +origin : str
    +destination : str
    +departure : datetime
    +arrival : datetime
    +gate : str [0..1]
    +rows : int
    +fare : int
    +status : FlightStatus
    +capacity() : int
  }
  class Booking {
    +booking_id : int
    +pnr : str
    +user_id : int
    +flight_id : int
    +seat : str
    +fare : int
    +status : BookingStatus
    +booked_at : datetime
    +checked_in_at : datetime [0..1]
    +boarding_seq : int [0..1]
  }
  class Bag {
    +bag_id : int
    +booking_id : int
    +tag_no : str
    +weight_kg : float
    +status : BagStatus
    +updated_at : datetime
  }
  class BookingDetails {
    +booking : Booking
    +passenger_name : str
    +flight_no : str
    +departure : datetime
    +gate : str
    +flight_status : FlightStatus
  }
  class BoardingPass {
    +pnr : str
    +passenger_name : str
    +flight_no : str
    +boarding_time : datetime
    +gate : str
    +seat : str
    +boarding_seq : int
    +as_text() : str
  }
}
User "1" -- "0..*" Booking : holds >
Flight "1" -- "0..*" Booking : reserved on <
Booking "1" *-- "0..3" Bag : checks >
BookingDetails o-- "1" Booking
Booking "1" ..> "0..1" BoardingPass : produces >
User ..> Role
Flight ..> FlightStatus
Booking ..> BookingStatus
Bag ..> BagStatus
@enduml
